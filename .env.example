# Copy to .env and fill in values before running.

# Generate with: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# Random string, 32+ characters. Change this to invalidate all sessions.
SESSION_SECRET=

# Session duration in days (default: 30)
SESSION_MAX_AGE_DAYS=30

# Set to "false" for local HTTP dev (no HTTPS). Must be "true" in production.
COOKIE_SECURE=true

# SQLite database path inside the container
DATABASE_URL=sqlite:////data/spread.db

# Image storage path inside the container
IMAGE_DIR=/data/images
